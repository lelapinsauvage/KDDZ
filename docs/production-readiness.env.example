# Production readiness evidence pointers.
# Copy these names into the production secret/evidence manager and replace
# placeholder values outside the repo. `audit-production-readiness.ts`
# treats the sample `non-secret-report-id` value as missing evidence.
# Do not commit real URLs, tokens, credentials, private user data, or raw
# report contents.

# PROD-DUMPS
LEGACY_PRODUCTION_DUMP_MANIFEST=non-secret-report-id
LEGACY_FIRST_MIGRATION_SOURCE_REPORT=non-secret-report-id

# PROD-MEDIA
LEGACY_MEDIA_AUDIT_REPORT=non-secret-report-id
LEGACY_MEDIA_EXPORT_MANIFEST=non-secret-report-id
LEGACY_MEDIA_UPLOAD_MANIFEST=non-secret-report-id
LEGACY_MEDIA_URL_APPLY_MANIFEST=non-secret-report-id

# PROD-RECON
MIGRATION_RECONCILIATION_REPORT=non-secret-report-id

# PROD-CRON
PRODUCTION_CRONTAB_EVIDENCE=non-secret-report-id
CRON_HELPER_DECISION_REPORT=non-secret-report-id
HOSTED_SCHEDULER_EVIDENCE=non-secret-report-id
# Configure one of these outside the repo:
# CRON_SECRET
# VERCEL_CRON_SECRET

# PROD-PROVIDERS
PROVIDER_DELIVERY_ACCEPTANCE_REPORT=non-secret-report-id
PUSH_DELIVERY_PROVIDER=disabled
EMAIL_DELIVERY_PROVIDER=disabled
SMS_DELIVERY_PROVIDER=disabled
WHATSAPP_DELIVERY_PROVIDER=disabled
# Configure provider-specific secret values outside the repo when enabled:
# PUSH_DELIVERY_WEBHOOK_URL
# ONESIGNAL_APP_ID
# ONESIGNAL_REST_API_KEY
# ONESIGNAL_API_KEY
# EMAIL_DELIVERY_WEBHOOK_URL
# RESEND_API_KEY
# EMAIL_FROM

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  ADMIN
  TEACHER
  NURSE
  DOCTOR
  MANAGER
}

enum Gender {
  MALE
  FEMALE
}

enum ParentType {
  MOTHER
  FATHER
}

enum DailyReportStatus {
  DRAFT
  SUBMITTED
}

enum AbsenceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MedicalFormType {
  GENERAL
  CONDITIONS
  VISITS
  VACCINATIONS
  ACCIDENTS
}

enum MedicalFormStatus {
  DRAFT
  SUBMITTED
  REVIEWED
}

enum FoodCategory {
  BREAKFAST
  LUNCH
  DESSERT
  SNACK
}

enum MealType {
  BREAKFAST
  LUNCH
  DESSERT
  SNACK
}

enum PaymentMethod {
  CASH
  CHECK
  TRANSFER
  CREDIT_CARD
}

enum PaymentCategory {
  REGISTRATION
  MONTHLY
  BUS
  XTRA_TIME
  FOOD
  OTHER
}

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
}

enum AccountingEntryType {
  FEE
  DISCOUNT
  PAYMENT
  ADJUSTMENT
}

enum SenderType {
  ADMIN
  TEACHER
  PARENT
}

enum RecipientType {
  ADMIN
  TEACHER
  PARENT
}

enum AlarmType {
  BIRTHDAY
  ASSESSMENT
  VACCINATION
  MEDICAL
  MEDICINE
  EVENT
  INSURANCE
  PAYMENT
  REQUEST
  CONTRACT
  OTHER
}

enum PushPlatform {
  IOS
  ANDROID
  WEB
}

enum EmployeeEventStatus {
  SICK
  ABSENT
  DAY_OFF
  WARNING
}

enum AttendanceLogStatus {
  CHECK_IN
  CHECK_OUT
  LATE
  EARLY_LEAVE
}

enum AssessmentStatus {
  DRAFT
  SUBMITTED
  REVIEWED
}

enum CallDirection {
  INCOMING
  OUTGOING
  MISSED
}

enum PortionSize {
  NONE
  LITTLE
  HALF
  MOST
  ALL
}

enum AgeUnit {
  YEARS
  MONTHS
}

enum DocumentType {
  COMMERCIAL_REGISTER
  CIVIL_STATUS
  CRIMINAL_RECORD
  LEASE_CONTRACT
  PROPERTY_DEED
  HEALTH_LICENSE
  FIRE_SAFETY
  INSURANCE_CERTIFICATE
  DIRECTOR_DIPLOMA
  DOCTOR_LICENSE
  FLOOR_PLAN
  CERTIFIED_PHOTO
  ID_COPY
  BUILDING_MAP
  CHILD_SAFETY_INSURANCE
  INTERNAL_REGULATIONS
  HEALTH_FILE
  DOCTOR_PLEDGE
  NURSE_LICENSE
  OTHER
}

enum DocumentStatus {
  PENDING
  UPLOADED
  VERIFIED
  EXPIRED
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum ExperienceType {
  WORK
  STAGE
  WORKSHOP
}

enum EmployeeDocumentType {
  CONTRACT
  MEDICAL_TEST
  FIRST_AID
  CERTIFICATE
  ATTACHMENT
}

enum LanguageName {
  ENGLISH
  FRENCH
  ARABIC
}

enum LanguageProficiency {
  NONE
  BASIC
  INTERMEDIATE
  ADVANCED
  FLUENT
}

// ─────────────────────────────────────────────
// ORGANIZATION & STRUCTURE
// ─────────────────────────────────────────────

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  logo      String?
  plan      String   @default("free")
  isActive  Boolean  @default(true)
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches                Branch[]
  users                   User[]
  schoolYears             SchoolYear[]
  foods                   Food[]
  assessmentScheduleRules AssessmentScheduleRule[]
  eventTypes              EventType[]
  events                  Event[]
  notificationTemplates   NotificationTemplate[]

  @@map("organizations")
}

model Branch {
  id             String   @id @default(uuid()) @db.Uuid
  sourceDatabase String?
  legacyKey      String?  @unique
  legacyId       Int?
  legacyTable    String?
  organizationId String   @db.Uuid
  name           String
  prefix         String?
  address        String?
  phone          String?
  telephone      String?
  email          String?
  imageUrl       String?
  themeColor     String?  @default("#1caf9a")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  users           User[]
  classes         Class[]
  settings        Settings[]
  teachers        Teacher[]
  nurses          Nurse[]
  doctors         Doctor[]
  managers        Manager[]
  children        Child[]
  foodCalendars   FoodCalendar[]
  events          Event[]
  holidays        Holiday[]
  alarms          Alarm[]
  assessmentDates AssessmentDate[]
  compliance      BranchCompliance?
  documents       BranchDocument[]

  @@index([organizationId])
  @@index([sourceDatabase])
  @@index([legacyId])
  @@index([legacyTable])
  @@map("branches")
}

model BranchCompliance {
  id       String @id @default(uuid()) @db.Uuid
  branchId String @unique @db.Uuid

  sourceDatabase String?
  legacyKey      String? @unique
  legacyId       Int?
  legacyBranchId Int?
  legacyUserId   Int?

  // Section A: Legal Entity Type
  entityType       String?
  legalName        String?
  organizationType String?
  companySubType   String?
  purpose          String? @db.Text

  // Section B: Owner Information (معلومات عن صاحب العلاقة)
  ownerFirstName        String?
  ownerFatherName       String?
  ownerFamilyName       String?
  ownerMotherName       String?
  ownerMotherMaidenName String?
  ownerDob              DateTime? @db.Date
  ownerPlaceOfBirth     String?
  ownerNationality      String?
  ownerRegistryNumber   String?

  // Legacy signatory fields (kept for backward compat)
  registrationNumber   String?
  registrationPlace    String?
  registrationDate     DateTime? @db.Date
  signatoryName        String?
  signatoryRole        String?
  signatoryNationality String?
  signatoryPhone       String?

  // Section C: Nursery Identity
  nameArabic String?
  nameLatin  String?

  // Section D: Nursery Address (عنوان الحضانة)
  country        String? @default("Lebanon")
  governorate    String?
  district       String?
  town           String?
  realEstateArea String?
  propertyNumber String?
  addressSection String?
  street         String?
  building       String?
  floor          String?
  addrPhone      String?
  addrFax        String?
  addrEmail      String?
  postalCode     String?

  // Legacy address fields (kept for backward compat)
  landmark    String?
  poBox       String?
  addrMobile  String?
  addrWebsite String?

  // Property / Lease (legacy)
  ownerName              String?
  propertyGovernorate    String?
  propertyDistrict       String?
  propertyRegion         String?
  ownershipType          String?
  specialFor             String?
  specialNumber          String?
  specialDate            DateTime? @db.Date
  applicationOwnerName   String?
  applicationNumber      String?
  applicationRegion      String?
  applicationGovernorate String?
  applicationDistrict    String?
  leaseOwnerName         String?
  leaseDate              DateTime? @db.Date
  leaseVerified          String?

  // Management (legacy)
  directorFirstName String?
  directorLastName  String?
  directorSpecialty String?
  doctorFirstName   String?
  doctorFatherName  String?
  doctorLastName    String?
  doctorSyndicateNo String?
  doctorSpecialty   String?

  // Capacity (legacy)
  totalChildren Int?
  walkers       Int?
  nonWalkers    Int?
  workingHours  String?

  // Insurance (legacy)
  insuranceCompany      String?
  insuranceContractType String?

  // Progress
  completionPercentage Int     @default(0)
  legacyLatitude       String? @db.Text
  legacyLongitude      String? @db.Text
  legacyData           Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([sourceDatabase])
  @@index([legacyId])
  @@index([legacyBranchId])
  @@index([branchId])
  @@map("branch_compliance")
}

model BranchDocument {
  id             String         @id @default(uuid()) @db.Uuid
  branchId       String         @db.Uuid
  sourceDatabase String?
  legacyKey      String?        @unique
  legacyId       Int?
  legacyBranchId Int?
  documentType   DocumentType
  label          String?
  filename       String?
  fileUrl        String?
  issueDate      DateTime?      @db.Date
  expiryDate     DateTime?      @db.Date
  status         DocumentStatus @default(PENDING)
  isActive       Boolean        @default(true)
  notes          String?        @db.Text
  legacyData     Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([sourceDatabase])
  @@index([legacyId])
  @@index([legacyBranchId])
  @@index([documentType])
  @@index([status])
  @@index([isActive])
  @@map("branch_documents")
}

model SchoolYear {
  id             String    @id @default(uuid()) @db.Uuid
  sourceDatabase String?
  legacyKey      String?   @unique
  legacyId       Int?
  legacySid      Int?
  legacyDate     DateTime? @db.Date
  label          String
  startDate      DateTime  @db.Date
  endDate        DateTime  @db.Date
  isActive       Boolean   @default(false)
  organizationId String?   @db.Uuid
  legacyData     Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization      Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  children          Child[]
  assessments       Assessment[]
  accountingEntries AccountingEntry[]

  @@index([sourceDatabase])
  @@index([legacyId])
  @@index([legacySid])
  @@index([organizationId])
  @@map("school_years")
}

model Class {
  id             String   @id @default(uuid()) @db.Uuid
  sourceDatabase String?
  legacyKey      String?  @unique
  legacyId       Int?
  legacyTable    String?
  branchId       String   @db.Uuid
  name           String
  language       String?
  ageFrom        Int?
  ageTo          Int?
  ageFromUnit    AgeUnit?
  ageToUnit      AgeUnit?
  cameraNumber   Int?
  maxStudents    Int      @default(0)
  imageUrl       String?
  capacity       Int      @default(0)
  ageGroup       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch           Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  children         Child[]
  teachers         Teacher[]
  foodApplications FoodApplication[]

  @@index([branchId])
  @@index([sourceDatabase])
  @@index([legacyId])
  @@index([legacyTable])
  @@map("classes")
}

model Settings {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @db.Uuid
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, key])
  @@index([branchId])
  @@map("settings")
}

// ─────────────────────────────────────────────
// USERS & AUTH (Auth.js compatible)
// ─────────────────────────────────────────────

model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  emailVerified  DateTime?
  passwordHash   String?
  name           String?
  image          String?
  role           UserRole  @default(TEACHER)
  isActive       Boolean   @default(true)
  branchId       String?   @db.Uuid
  organizationId String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  accounts              Account[]
  sessions              Session[]
  dailyReports          DailyReport[]          @relation("DailyReportCreator")
  absenceReports        AbsenceReport[]        @relation("AbsenceReportCreator")
  assessments           Assessment[]           @relation("AssessmentCreator")
  payments              Payment[]              @relation("PaymentCreator")
  callLogs              CallLog[]              @relation("CallLogCreator")
  medicalForms          MedicalForm[]          @relation("MedicalFormCreator")
  notifications         Notification[]
  notificationTemplates NotificationTemplate[] @relation("TemplateCreator")
  pushTokens            PushToken[]            @relation("UserPushTokens")
  foodApplications      FoodApplication[]      @relation("FoodApplicationCreator")

  @@index([branchId])
  @@index([organizationId])
  @@index([email])
  @@index([role])
  @@map("users")
}

model Account {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  sessionToken String   @unique
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model ParentUser {
  id             String   @id @default(uuid()) @db.Uuid
  sourceDatabase String?
  legacyKey      String?  @unique
  legacyId       Int?
  legacyChildId  Int?
  username       String   @unique
  passwordHash   String
  token          String?
  isActive       Boolean  @default(true)
  childId        String   @db.Uuid
  legacyData     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  child      Child       @relation(fields: [childId], references: [id], onDelete: Cascade)
  pushTokens PushToken[] @relation("ParentPushTokens")

  @@index([sourceDatabase])
  @@index([legacyId])
  @@index([legacyChildId])
  @@index([childId])
  @@index([username])
  @@map("parent_users")
}

// ─────────────────────────────────────────────
// CHILDREN
// ─────────────────────────────────────────────

model Child {
  id                   String    @id @default(uuid()) @db.Uuid
  sourceDatabase       String?
  legacyKey            String?   @unique
  legacyId             Int?
  legacyTable          String?
  firstName            String
  firstNameAr          String?
  middleName           String?
  lastName             String
  lastNameAr           String?
  dateOfBirth          DateTime? @db.Date
  placeOfBirth         String?
  gender               Gender?
  nationality          String?
  religion             String?
  idNumber             String?
  bloodType            String?
  allergies            String?   @db.Text
  photo                String?
  branchId             String    @db.Uuid
  classId              String?   @db.Uuid
  schoolYearId         String?   @db.Uuid
  isActive             Boolean   @default(true)
  isDraft              Boolean   @default(false)
  enrollmentDate       DateTime? @db.Date
  busAttendance        String?   @default("false")
  diaperType           String?
  milkType             String?
  milkPortions         Int?
  milkScoop            Int?
  milkTime1            DateTime? @db.Time(6)
  milkTime2            DateTime? @db.Time(6)
  milkTime3            DateTime? @db.Time(6)
  lunchIncluded        Boolean   @default(true)
  sleepFrom            DateTime? @db.Time(6)
  sleepTo              DateTime? @db.Time(6)
  remarks              String?   @db.Text
  language             String?
  previousGarderie     Boolean   @default(false)
  previousGarderieName String?
  childNumber          String?

  // Financial
  garderieFees     Decimal? @db.Decimal(10, 2)
  extraFees        Decimal? @db.Decimal(10, 2)
  busFees          Decimal? @db.Decimal(10, 2)
  apronFees        Decimal? @db.Decimal(10, 2)
  registrationFees Decimal? @db.Decimal(10, 2)
  activitiesFees   Decimal? @db.Decimal(10, 2)
  discount         Decimal? @db.Decimal(10, 2)
  tva              Decimal? @db.Decimal(5, 2)
  financialRemarks String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch     Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  class      Class?      @relation(fields: [classId], references: [id], onDelete: SetNull)
  schoolYear SchoolYear? @relation(fields: [schoolYearId], references: [id], onDelete: SetNull)

  addresses         ChildAddress[]
  parents           Parent[]
  relatives         Relative[]
  siblings          ChildSibling[]
  attachments       ChildAttachment[]
  history           ChildHistory[]
  previousGarderies ChildPreviousGarderie[]
  parentUsers       ParentUser[]
  dailyReports      DailyReport[]
  absenceReports    AbsenceReport[]
  medicalForms      MedicalForm[]
  vaccinations      Vaccination[]
  assessments       Assessment[]
  payments          Payment[]
  paymentReminders  PaymentReminder[]
  accountingEntries AccountingEntry[]
  callLogs          CallLog[]
  foodApplications  FoodApplication[]
  formAttachments   FormAttachment[]

  @@index([branchId])
  @@index([classId])
  @@index([schoolYearId])
  @@index([sourceDatabase])
  @@index([legacyId])
  @@index([legacyTable])
  @@index([isActive])
  @@index([lastName, firstName])
  @@map("children")
}

model ChildAddress {
  id          String   @id @default(uuid()) @db.Uuid
  childId     String   @db.Uuid
  addressType String?
  country     String?  @default("Lebanon")
  street      String?
  building    String?
  floor       String?
  city        String?
  telephone   String?
  regionId    String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  child  Child   @relation(fields: [childId], references: [id], onDelete: Cascade)
  region Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)

  @@index([childId])
  @@index([regionId])
  @@map("child_addresses")
}

model Parent {
  id               String     @id @default(uuid()) @db.Uuid
  childId          String     @db.Uuid
  type             ParentType
  firstName        String?
  lastName         String?
  nationality      String?
  phone            String?
  mobile           String?
  email            String?
  profession       String?
  workplace        String?
  workPhone        String?
  maritalStatus    String?
  divorceSituation String?
  medicalCase      String?
  canPickUp        Boolean    @default(true)
  idNumber         String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([type])
  @@map("parents")
}

model Relative {
  id                 String   @id @default(uuid()) @db.Uuid
  childId            String   @db.Uuid
  name               String
  lastName           String?
  relation           String?
  phone              String?
  mobile             String?
  isAuthorized       Boolean  @default(false)
  isEmergencyContact Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@map("relatives")
}

model ChildSibling {
  id          String    @id @default(uuid()) @db.Uuid
  childId     String    @db.Uuid
  relation    String?
  firstName   String?
  dateOfBirth DateTime? @db.Date
  medicalCase String?
  canPickUp   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@map("child_siblings")
}

model ChildAttachment {
  id             String   @id @default(uuid()) @db.Uuid
  childId        String   @db.Uuid
  sourceDatabase String?
  legacyKey      String?  @unique
  legacyId       Int?
  legacyChildId  Int?
  title          String?
  filename       String
  fileUrl        String
  type           String?
  isActive       Boolean  @default(true)
  legacyData     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([sourceDatabase])
  @@index([legacyId])
  @@index([legacyChildId])
  @@index([isActive])
  @@map("child_attachments")
}

model ChildHistory {
  id         String   @id @default(uuid()) @db.Uuid
  childId    String   @db.Uuid
  snapshot   Json
  changedBy  String?
  changeNote String?
  createdAt  DateTime @default(now())

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([createdAt])
  @@map("child_history")
}

model ChildPreviousGarderie {
  id             String   @id @default(uuid()) @db.Uuid
  sourceDatabase String
  legacyKey      String   @unique
  legacyId       Int
  childId        String?  @db.Uuid
  legacyChildId  Int?
  name           String?
  year           String?
  isActive       Boolean  @default(true)
  legacyData     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  child Child? @relation(fields: [childId], references: [id], onDelete: SetNull)

  @@index([sourceDatabase])
  @@index([legacyId])
  @@index([childId])
  @@index([legacyChildId])
  @@index([isActive])
  @@map("child_previous_garderies")
}

// ─────────────────────────────────────────────
// STAFF
// ─────────────────────────────────────────────

model Teacher {
  id                     String         @id @default(uuid()) @db.Uuid
  sourceDatabase         String?
  legacyKey              String?        @unique
  legacyId               Int?
  legacyTable            String?
  userId                 String?        @db.Uuid
  username               String?
  firstName              String
  middleName             String?
  lastName               String
  dateOfBirth            DateTime?      @db.Date
  placeOfBirth           String?
  registerNumber         String?
  nationality            String?
  maritalStatus          MaritalStatus?
  numberOfChildren       Int?
  gender                 Gender?
  medicalCase            Boolean?       @default(false)
  medicalCaseDescription String?        @db.Text
  phone                  String?
  telephone              String?
  mobile                 String?
  email                  String?
  cnss                   String?
  cnssNo                 String?
  secondaryDegree        String?
  secondaryDegreeYear    String?
  universityDegree       String?
  universityDegreeYear   String?
  remarks                String?        @db.Text
  imageUrl               String?
  hireDate               DateTime?      @db.Date
  branchId               String         @db.Uuid
  classId                String?        @db.Uuid
  specialization         String?
  isActive               Boolean        @default(true)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  branch      Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  class       Class?              @relation(fields: [classId], references: [id], onDelete: SetNull)
  addresses   TeacherAddress[]
  attachments TeacherAttachment[]
  languages   TeacherLanguage[]
  experiences TeacherExperience[]
  documents   TeacherDocument[]

  @@index([branchId])
  @@index([sourceDatabase])
  @@index([legacyId])
  @@index([legacyTable])
  @@index([userId])
  @@index([classId])
  @@index([isActive])
  @@map("teachers")
}

model TeacherAddress {
  id          String   @id @default(uuid()) @db.Uuid
  teacherId   String   @db.Uuid
  governorate String?
  district    String?
  region      String?
  city        String?
  street      String?
  building    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@map("teacher_addresses")
}

model TeacherAttachment {
  id              String   @id @default(uuid()) @db.Uuid
  teacherId       String   @db.Uuid
  sourceDatabase  String?
  legacyKey       String?  @unique
  legacyId        Int?
  legacyTable     String?
  legacyTeacherId Int?
  filename        String
  fileUrl         String

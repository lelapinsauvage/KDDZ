model DailyReport {
  id               String            @id @default(uuid()) @db.Uuid
  childId          String            @db.Uuid
  reportDate       DateTime          @db.Date
  status           DailyReportStatus @default(DRAFT)
  breakfastFoodId  String?           @db.Uuid
  breakfastPortion PortionSize?
  breakfastTime    DateTime?         @db.Time(6)
  lunchFoodId      String?           @db.Uuid
  lunchPortion     PortionSize?
  lunchTime        DateTime?         @db.Time(6)
  dessert          String?
  dessertPortion   PortionSize?
  dessertTime      DateTime?         @db.Time(6)
  checkInTime      DateTime?         @db.Time(6)
  checkOutTime     DateTime?         @db.Time(6)
  isSleep          Boolean           @default(false)
  sleepFrom        DateTime?         @db.Time(6)
  sleepTo          DateTime?         @db.Time(6)
  sleepQuality     String?
  activities       String?           @db.Text
  medicine         String?           @db.Text
  diarrhea         Boolean           @default(false)
  urinePotty       Int               @default(0)
  stoolPotty       Int               @default(0)
  urineDiaper      Int               @default(0)
  stoolDiaper      Int               @default(0)
  mood             String?
  cough            Boolean           @default(false)
  runnyNose        Boolean           @default(false)
  vomit            Boolean           @default(false)
  remarks          String?           @db.Text
  legacyData       Json?
  createdById      String?           @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  child         Child                   @relation(fields: [childId], references: [id], onDelete: Cascade)
  breakfastFood Food?                   @relation("BreakfastFood", fields: [breakfastFoodId], references: [id], onDelete: SetNull)
  lunchFood     Food?                   @relation("LunchFood", fields: [lunchFoodId], references: [id], onDelete: SetNull)
  createdBy     User?                   @relation("DailyReportCreator", fields: [createdById], references: [id], onDelete: SetNull)
  fevers        DailyReportFever[]
  milks         DailyReportMilk[]
  attachments   DailyReportAttachment[]

  @@unique([childId, reportDate])
  @@index([childId])
  @@index([reportDate])
  @@index([status])
  @@index([createdById])
  @@index([breakfastFoodId])
  @@index([lunchFoodId])
  @@map("daily_reports")
}

